{
  "name": "scobees-mcp",
  "version": "0.1.1",
  "description": "MCP-Server für scobees (teach.scobees.com): Lernpfade, Gliederungen, Aufgaben und Serlo-Arbeitsblätter per Claude anlegen und bearbeiten – ohne Zugriff auf Schülerdaten.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "bin": { "scobees-mcp": "src/server.js" },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "login": "node src/server.js --login",
    "pack": "npx --yes @anthropic-ai/mcpb pack . scobees-mcp.mcpb"
  },
  "keywords": ["mcp", "scobees", "schule", "lernpfad", "serlo"],
  "repository": { "type": "git", "url": "https://github.com/wvssTobiKi/scobees-mcp.git" },
  "homepage": "https://github.com/wvssTobiKi/scobees-mcp#readme",
  "bugs": "https://github.com/wvssTobiKi/scobees-mcp/issues"
}
